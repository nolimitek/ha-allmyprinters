{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Conectar el agente AllMyPrinters",
        "description": "Introduce la dirección del agente AllMyPrinters y la clave de sus Ajustes → Home Assistant. Si el agente funciona como app AllMyPrinters Agent en Home Assistant, se encuentra automáticamente en Ajustes → Dispositivos y servicios.",
        "data": {
          "host": "Host",
          "port": "Puerto",
          "token": "Clave"
        },
        "data_description": {
          "host": "Dirección IP o nombre del equipo en el que funciona el agente, p. ej. 192.168.1.20.",
          "port": "Puerto de la interfaz web del agente (8090 si no lo has cambiado).",
          "token": "Empieza por amp_ha_. Aparece en el agente en Ajustes → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "App AllMyPrinters Agent encontrada",
        "description": "¿Añadir a Home Assistant las impresoras y bobinas de la app {addon}?"
      },
      "reauth_confirm": {
        "title": "Introduce la nueva clave",
        "description": "La clave guardada ya no funciona para el agente en {host}; probablemente se generó una nueva. Copia la clave actual en el agente en Ajustes → Home Assistant.",
        "data": {
          "token": "Clave"
        },
        "data_description": {
          "token": "Empieza por amp_ha_. Aparece en el agente en Ajustes → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "Esta clave no es válida. Cópiala de nuevo en el agente en Ajustes → Home Assistant.",
      "cannot_connect": "No se puede conectar con el agente en esta dirección. Comprueba el host, el puerto y que el agente esté en marcha."
    },
    "abort": {
      "already_configured": "Este agente ya está configurado. Se han actualizado su dirección y su clave.",
      "reauth_successful": "La nueva clave se ha guardado.",
      "wrong_account": "Esta clave pertenece a otro agente.",
      "already_in_progress": "Este agente ya se está configurando.",
      "invalid_discovery_info": "La app AllMyPrinters Agent envió datos de conexión incompletos. Actualiza la app y reiníciala."
    }
  },
