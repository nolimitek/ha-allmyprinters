{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "AllMyPrinters-Agent verbinden",
        "description": "Gib die Adresse des AllMyPrinters-Agenten und den Schlüssel aus seinen Einstellungen → Home Assistant ein. Läuft der Agent als App „AllMyPrinters Agent“ in Home Assistant, wird er unter Einstellungen → Geräte & Dienste automatisch gefunden.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Schlüssel"
        },
        "data_description": {
          "host": "IP-Adresse oder Hostname des Rechners, auf dem der Agent läuft, z. B. 192.168.1.20.",
          "port": "Port der Weboberfläche des Agenten (8090, sofern du ihn nicht geändert hast).",
          "token": "Beginnt mit amp_ha_. Steht im Agenten unter Einstellungen → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "App „AllMyPrinters Agent“ gefunden",
        "description": "Drucker und Spulen der App {addon} zu Home Assistant hinzufügen?"
      },
      "reauth_confirm": {
        "title": "Neuen Schlüssel eingeben",
        "description": "Der gespeicherte Schlüssel funktioniert für den Agenten unter {host} nicht mehr – vermutlich wurde er neu erzeugt. Kopiere den aktuellen Schlüssel im Agenten unter Einstellungen → Home Assistant.",
        "data": {
          "token": "Schlüssel"
        },
        "data_description": {
          "token": "Beginnt mit amp_ha_. Steht im Agenten unter Einstellungen → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "Dieser Schlüssel ist ungültig. Kopiere ihn erneut im Agenten unter Einstellungen → Home Assistant.",
      "cannot_connect": "Der Agent ist unter dieser Adresse nicht erreichbar. Prüfe Host und Port und ob der Agent läuft."
    },
    "abort": {
      "already_configured": "Dieser Agent ist bereits eingerichtet. Adresse und Schlüssel wurden aktualisiert.",
      "reauth_successful": "Der neue Schlüssel ist gespeichert.",
      "wrong_account": "Dieser Schlüssel gehört zu einem anderen Agenten.",
      "already_in_progress": "Dieser Agent wird bereits eingerichtet.",
      "invalid_discovery_info": "Die App „AllMyPrinters Agent“ hat unvollständige Verbindungsdaten gesendet. Aktualisiere die App und starte sie neu."
    }
