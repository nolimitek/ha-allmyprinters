{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "AllMyPrinters-agent koppelen",
        "description": "Voer het adres van de AllMyPrinters-agent in en de sleutel uit zijn Instellingen → Home Assistant. Draait de agent als app AllMyPrinters Agent in Home Assistant, dan wordt hij automatisch gevonden onder Instellingen → Apparaten en diensten.",
        "data": {
          "host": "Host",
          "port": "Poort",
          "token": "Sleutel"
        },
        "data_description": {
          "host": "IP-adres of hostnaam van de computer waarop de agent draait, bijv. 192.168.1.20.",
          "port": "Poort van de webinterface van de agent (8090, tenzij je hem hebt gewijzigd).",
          "token": "Begint met amp_ha_. Staat in de agent onder Instellingen → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "App AllMyPrinters Agent gevonden",
        "description": "De printers en spoelen van de app {addon} aan Home Assistant toevoegen?"
      },
      "reauth_confirm": {
        "title": "Nieuwe sleutel invoeren",
        "description": "De opgeslagen sleutel werkt niet meer voor de agent op {host} – waarschijnlijk is hij opnieuw aangemaakt. Kopieer de huidige sleutel in de agent onder Instellingen → Home Assistant.",
        "data": {
          "token": "Sleutel"
        },
        "data_description": {
          "token": "Begint met amp_ha_. Staat in de agent onder Instellingen → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "Deze sleutel is ongeldig. Kopieer hem opnieuw in de agent onder Instellingen → Home Assistant.",
      "cannot_connect": "De agent is op dit adres niet bereikbaar. Controleer host en poort en of de agent draait."
    },
    "abort": {
      "already_configured": "Deze agent is al ingesteld. Adres en sleutel zijn bijgewerkt.",
      "reauth_successful": "De nieuwe sleutel is opgeslagen.",
      "wrong_account": "Deze sleutel hoort bij een andere agent.",
      "already_in_progress": "Deze agent wordt al ingesteld.",
      "invalid_discovery_info": "De app AllMyPrinters Agent stuurde onvolledige verbindingsgegevens. Werk de app bij en start hem opnieuw."
