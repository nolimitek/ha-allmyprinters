{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect the AllMyPrinters agent",
        "description": "Enter the address of the AllMyPrinters agent and the key from its Settings → Home Assistant. If the agent runs as the AllMyPrinters Agent app in Home Assistant, it is found automatically under Settings → Devices & services.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Key"
        },
        "data_description": {
          "host": "IP address or host name of the computer running the agent, e.g. 192.168.1.20.",
          "port": "Port of the agent's web interface (8090 unless you changed it).",
          "token": "Starts with amp_ha_. Shown in the agent under Settings → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "AllMyPrinters Agent app found",
        "description": "Add the printers and spools of the {addon} app to Home Assistant?"
      },
      "reauth_confirm": {
        "title": "Enter the new key",
        "description": "The saved key no longer works for the agent at {host} – it was probably regenerated. Copy the current key from the agent under Settings → Home Assistant.",
        "data": {
          "token": "Key"
        },
        "data_description": {
          "token": "Starts with amp_ha_. Shown in the agent under Settings → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "This key is not valid. Copy it again from the agent under Settings → Home Assistant.",
      "cannot_connect": "Could not reach the agent at this address. Check host and port and that the agent is running."
    },
    "abort": {
      "already_configured": "This agent is already set up. Its address and key have been updated.",
      "reauth_successful": "The new key is saved.",
      "wrong_account": "This key belongs to a different agent.",
      "already_in_progress": "This agent is already being set up.",
      "invalid_discovery_info": "The AllMyPrinters Agent app sent incomplete connection details. Update the app and restart it."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Update interval"
        },
        "data_description": {
          "scan_interval": "How often Home Assistant asks the agent (seconds). The agent itself checks the printers every 15 seconds."
        }
      }
    }
