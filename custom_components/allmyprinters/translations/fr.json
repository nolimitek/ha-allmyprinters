          "token": "Clé"
        },
        "data_description": {
          "token": "Commence par amp_ha_. Affichée dans l’agent sous Réglages → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "Cette clé n’est pas valide. Copiez-la à nouveau dans l’agent sous Réglages → Home Assistant.",
