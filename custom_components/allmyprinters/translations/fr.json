{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connecter l’agent AllMyPrinters",
        "description": "Saisissez l’adresse de l’agent AllMyPrinters et la clé de ses Réglages → Home Assistant. Si l’agent tourne comme app AllMyPrinters Agent dans Home Assistant, il est trouvé automatiquement sous Paramètres → Appareils et services.",
        "data": {
          "host": "Hôte",
          "port": "Port",
          "token": "Clé"
        },
        "data_description": {
          "host": "Adresse IP ou nom d’hôte de l’ordinateur sur lequel tourne l’agent, par ex. 192.168.1.20.",
          "port": "Port de l’interface web de l’agent (8090 si vous ne l’avez pas modifié).",
          "token": "Commence par amp_ha_. Affichée dans l’agent sous Réglages → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "App AllMyPrinters Agent trouvée",
        "description": "Ajouter à Home Assistant les imprimantes et bobines de l’app {addon} ?"
      },
      "reauth_confirm": {
        "title": "Saisir la nouvelle clé",
        "description": "La clé enregistrée ne fonctionne plus pour l’agent sur {host} – elle a probablement été régénérée. Copiez la clé actuelle dans l’agent sous Réglages → Home Assistant.",
