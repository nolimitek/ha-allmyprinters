{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Collega l’agente AllMyPrinters",
        "description": "Inserisci l’indirizzo dell’agente AllMyPrinters e la chiave dalle sue Impostazioni → Home Assistant. Se l’agente funziona come app AllMyPrinters Agent in Home Assistant, viene trovato automaticamente in Impostazioni → Dispositivi e servizi.",
        "data": {
          "host": "Host",
          "port": "Porta",
          "token": "Chiave"
        },
        "data_description": {
          "host": "Indirizzo IP o nome host del computer su cui funziona l’agente, ad es. 192.168.1.20.",
          "port": "Porta dell’interfaccia web dell’agente (8090 se non l’hai cambiata).",
          "token": "Inizia con amp_ha_. Si trova nell’agente in Impostazioni → Home Assistant."
        }
      },
      "hassio_confirm": {
        "title": "App AllMyPrinters Agent trovata",
        "description": "Aggiungere a Home Assistant le stampanti e le bobine dell’app {addon}?"
      },
      "reauth_confirm": {
        "title": "Inserisci la nuova chiave",
        "description": "La chiave salvata non funziona più per l’agente su {host}: probabilmente è stata rigenerata. Copia la chiave attuale nell’agente in Impostazioni → Home Assistant.",
        "data": {
          "token": "Chiave"
        },
        "data_description": {
          "token": "Inizia con amp_ha_. Si trova nell’agente in Impostazioni → Home Assistant."
        }
      }
    },
    "error": {
      "invalid_key": "Questa chiave non è valida. Copiala di nuovo nell’agente in Impostazioni → Home Assistant.",
      "cannot_connect": "Impossibile raggiungere l’agente a questo indirizzo. Controlla host, porta e che l’agente sia in funzione."
    },
    "abort": {
      "already_configured": "Questo agente è già configurato. Indirizzo e chiave sono stati aggiornati.",
      "reauth_successful": "La nuova chiave è stata salvata.",
      "wrong_account": "Questa chiave appartiene a un altro agente.",
      "already_in_progress": "Questo agente è già in fase di configurazione.",
      "invalid_discovery_info": "L’app AllMyPrinters Agent ha inviato dati di connessione incompleti. Aggiorna l’app e riavviala."
